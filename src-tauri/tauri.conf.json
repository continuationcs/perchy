{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coquou",
  "version": "0.1.0",
  "identifier": "io.github.coquou",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Coquou",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "presets/": "presets/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pet"
        ],
        "name": "Coquou Pet",
        "description": "Coquou 宠物包",
        "role": "Viewer",
        "rank": "Owner",
        "mimeType": "application/x-coquou-pet",
        "contentTypes": [
          "io.github.coquou.pet"
        ],
        "exportedType": {
          "identifier": "io.github.coquou.pet",
          "conformsTo": [
            "public.zip-archive"
          ]
        }
      }
    ],
    "createUpdaterArtifacts": false,
    "publisher": "continuationcs",
    "copyright": "© 2026 continuationcs and Coquou contributors",
    "category": "Entertainment",
    "shortDescription": "开源桌面宠物",
    "longDescription": "Coquou 是一个开源的桌面宠物：可爱的小家伙在屏幕角落溜达，可以摸、拎、扔，兼容 Codex 宠物包，也能用 AI 孵化你自己的宠物。",
    "homepage": "https://github.com/continuationcs/perchy",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0RTYwMTk2OEU1NTFDRUEKUldUcUhGV09sZ0htbEd5ZzFVa3hZMjVKQmZ6M0NzOFo2UGpsajJyYTVPUU9taC9HK0dhcVpkeEMK",
      "endpoints": [
        "https://github.com/continuationcs/perchy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
