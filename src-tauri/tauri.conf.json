{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Perchy",
  "version": "0.1.0",
  "identifier": "io.perchy.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Perchy",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "presets/": "presets/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pet"
        ],
        "name": "Perchy Pet",
        "description": "Perchy 宠物包",
        "role": "Viewer",
        "rank": "Owner",
        "mimeType": "application/x-perchy-pet",
        "contentTypes": [
          "io.perchy.pet"
        ],
        "exportedType": {
          "identifier": "io.perchy.pet",
          "conformsTo": [
            "public.zip-archive"
          ]
        }
      }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0RTYwMTk2OEU1NTFDRUEKUldUcUhGV09sZ0htbEd5ZzFVa3hZMjVKQmZ6M0NzOFo2UGpsajJyYTVPUU9taC9HK0dhcVpkeEMK",
      "endpoints": [
        "https://github.com/continuationcs/perchy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
